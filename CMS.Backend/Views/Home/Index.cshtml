@model IEnumerable<CMS.Data.Entities.Post>

<style>
    /* KHU VỰC THANH TIỆN ÍCH KHÁCH HÀNG */
    .vintage-top-bar {
        background-color: #3d312a;
        border-bottom: 1px dashed #52433a;
        padding: 8px 0;
    }

    .btn-customer-auth {
        font-family: 'Quicksand', sans-serif;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #f5ebd9 !important;
        text-decoration: none;
        transition: all 0.3s ease;
        border: 1px solid transparent;
        padding: 4px 12px;
    }

        .btn-customer-auth:hover {
            color: #ffffff !important;
            border: 1px dashed #c49a6c;
        }

    /* KHỐI BANNER */
    .vintage-hero-banner {
        background-color: #eae5da;
        border: 2px dashed #52433a;
        position: relative;
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background-image: linear-gradient(rgba(61, 49, 42, 0.4), rgba(61, 49, 42, 0.6)), url('https://placehold.co/1920x600/eae5da/3d312a?text=ThienCMS+Vintage+Store+Banner');
        background-size: cover;
        background-position: center;
    }

    .banner-content-box {
        max-width: 700px;
        padding: 30px;
        border: 1px solid rgba(245, 235, 217, 0.3);
        background-color: rgba(61, 49, 42, 0.75);
    }

    /* STYLE LUXURY */
    .limited-title {
        font-family: 'Playfair Display', 'Georgia', serif;
        font-weight: 700;
        letter-spacing: 2px;
        color: #3d312a;
        position: relative;
        padding-bottom: 15px;
    }

        .limited-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 2px;
            background-color: #c49a6c;
        }

    .luxury-card {
        border: 1px solid #e8e3d7;
        border-radius: 0px;
        background-color: #fdfbf7 !important;
        transition: all 0.4s ease;
    }

        .luxury-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(61, 49, 42, 0.12) !important;
            border-color: #556b2f;
        }

    .btn-gold {
        background-color: #556b2f;
        color: #fffdec;
        border: 1px solid #485c28;
        border-radius: 0px;
        letter-spacing: 1px;
        font-size: 0.8rem;
        text-transform: uppercase;
        font-weight: 700;
        transition: all 0.3s ease;
    }

        .btn-gold:hover {
            background-color: #3d312a;
            border-color: #2b221d;
            color: #f5ebd9;
        }

    .btn-outline-gold {
        background-color: transparent;
        color: #3d312a;
        border: 1px solid #3d312a;
        border-radius: 0px;
        letter-spacing: 1px;
        font-size: 0.8rem;
        text-transform: uppercase;
        font-weight: 700;
        transition: all 0.3s ease;
    }

        .btn-outline-gold:hover {
            background-color: #3d312a;
            color: #fffdec;
        }

    .gold-text {
        font-family: 'Playfair Display', serif;
        color: #8b4513;
    }

    /* ĐỊNH DẠNG THANH MENU DANH MỤC SẢN PHẨM */
    .vintage-nav-tabs {
        border-bottom: 2px solid #e8e3d7;
        justify-content: center;
        gap: 10px;
    }

        .vintage-nav-tabs .nav-link {
            font-family: 'Quicksand', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.85rem;
            color: #8c7667;
            border: 1px solid transparent;
            border-radius: 0px;
            padding: 10px 20px;
            transition: all 0.3s;
        }

            .vintage-nav-tabs .nav-link:hover {
                color: #3d312a;
                background-color: #eae5da;
                border-color: #e8e3d7 #e8e3d7 transparent;
            }

            .vintage-nav-tabs .nav-link.active {
                color: #fffdec !important;
                background-color: #556b2f !important;
                border-color: #485c28 !important;
            }
</style>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

<div class="vintage-top-bar w-100">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
        <div class="text-muted small d-none d-sm-block italic" style="color: #a8968a !important;">
            <i class="bi bi-clock"></i> Chào mừng quý khách đến với không gian hoài niệm.
        </div>
        <div class="ms-auto d-flex gap-2">
            <a asp-controller="CustomerAccount" asp-action="Login" class="btn-customer-auth">
                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
            </a>
            <div class="text-secondary align-self-center" style="color: #52433a;">|</div>
            <a asp-controller="CustomerAccount" asp-action="Register" class="btn-customer-auth">
                <i class="bi bi-person-plus"></i> Đăng ký thành viên
            </a>
        </div>
    </div>
</div>

<div class="container-fluid px-0 mb-5">
    <div class="vintage-hero-banner">
        <div class="banner-content-box shadow-lg text-white">
            <span class="text-uppercase small tracking-widest d-block mb-2" style="color: #c49a6c; letter-spacing: 3px;">— THIEN CMS EST. 2026 —</span>
            <h1 class="display-5 fw-bold mb-3" style="font-family: 'Playfair Display', serif; color: #f5ebd9;">KHÔNG GIAN LƯU GIỮ KỶ NIỆM</h1>
            <p class="lead small font-serif italic mb-4" style="color: #d2c5b9;">Nơi trưng bày các sản phẩm thủ công, độc bản mang dấu ấn trường tồn của thời gian.</p>
            <a href="#collection-section" class="btn btn-gold px-4 py-2">Khám phá bộ sưu tập</a>
        </div>
    </div>
</div>

<div class="container my-5 py-2">
    <div style="width: 100%; height: 1px; background: linear-gradient(to right, transparent, #c49a6c, transparent);"></div>
</div>

<div id="collection-section" class="container mb-5">
    <div class="text-center mb-5">
        <span class="text-muted text-uppercase small tracking-widest d-block mb-2" style="letter-spacing: 2px;">— LIMITED EDITION —</span>
        <h2 class="limited-title text-uppercase">Bộ Sưu Tập Độc Bản</h2>
    </div>

    @{
        // Ép kiểu dynamic để giải quyết triệt để xung đột Namespace phân tầng hệ thống
        var categories = ViewBag.CategoryWithProducts as dynamic;
    }

    @if (categories != null)
    {
        <ul class="nav nav-tabs vintage-nav-tabs border-0 mb-4" id="vintageCategoryTabs" role="tablist">
            @{
                int indexTab = 0;
            }
            @foreach (var cat in categories)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(indexTab == 0 ? "active" : "")" id="tab-cat-@cat.Id" data-bs-toggle="tab" data-bs-target="#panel-cat-@cat.Id" type="button" role="tab" aria-controls="panel-cat-@cat.Id" aria-selected="@(indexTab == 0 ? "true" : "false")">
                        <i class="bi bi-tag-fill me-1"></i> @cat.Name
                    </button>
                </li>
                indexTab++;
            }
        </ul>

        <div class="tab-content" id="vintageCategoryTabsContent">
            @{
                int indexPanel = 0;
            }
            @foreach (var cat in categories)
            {
                <div class="tab-pane fade @(indexPanel == 0 ? "show active" : "")" id="panel-cat-@cat.Id" role="tabpanel" aria-labelledby="tab-cat-@cat.Id">
                    <div class="row">
                        @if (cat.Products != null)
                        {
                            foreach (var prod in cat.Products)
                            {
                                <div class="col-lg-3 col-md-6 mb-4">
                                    <div class="card luxury-card h-100 shadow-sm">
                                        <div class="overflow-hidden bg-light position-relative">
                                            <img src="@prod.ImageUrl" class="card-img-top w-100" style="height: 280px; object-fit: cover;" alt="@prod.Name">
                                            <span class="position-absolute top-0 start-0 text-white px-2 py-1 small" style="font-size: 0.7rem; letter-spacing: 1px; background-color: #3d312a !important;">LIMITED</span>
                                        </div>
                                        <div class="card-body d-flex flex-column justify-content-between p-4">
                                            <div class="text-center">
                                                <h5 class="card-title text-dark fw-bold mb-2" style="font-size: 1.05rem; line-height: 1.4;">@prod.Name</h5>
                                                <p class="gold-text fw-bold mb-3" style="font-size: 1.1rem;">@prod.Price.ToString("#,##0") đ</p>
                                            </div>
                                            <a href="/Product/Details/@prod.Id" class="btn btn-gold w-100 py-2">Sở Hữu Ngay</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                indexPanel++;
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted py-4">
            <p class="italic"><i class="bi bi-tags"></i> Hệ thống phân loại đang tải dữ liệu bộ sưu tập...</p>
        </div>
    }
</div>

<div class="container my-5 py-2">
    <div style="width: 100%; height: 1px; background: linear-gradient(to right, transparent, #c49a6c, transparent);"></div>
</div>

<div class="container mb-5 pb-5">
    <div class="text-center mb-5">
        <span class="text-muted text-uppercase small tracking-widest d-block mb-2" style="letter-spacing: 2px;">— INSIGHT & MAGAZINE —</span>
        <h2 class="limited-title text-uppercase">Câu Chuyện Phong Cách</h2>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card luxury-card h-100 shadow-sm">
                    <div class="overflow-hidden">
                        <img src="@item.ImageUrl" class="card-img-top w-100" style="height: 220px; object-fit: cover;" alt="Thumbnail">
                    </div>
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-dark text-uppercase px-2 py-1" style="font-size: 0.65rem; font-weight: 500; border-radius: 0; background-color: #556b2f !important;">@item.Category?.Name</span>
                                <small class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-calendar3"></i> @item.CreatedDate.ToString("dd / MM / yyyy")</small>
                            </div>
                            <h5 class="card-title text-dark fw-bold mb-2" style="font-size: 1.1rem; line-height: 1.4;">@item.Title</h5>
                            <div class="card-text text-muted small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 42px;">
                                @Html.Raw(System.Text.RegularExpressions.Regex.Replace(item.Content ?? "", "<.*?>", string.Empty))
                            </div>
                        </div>
                        <div class="pt-3">
                            <a href="/Post/Details/@item.Id" class="btn btn-outline-gold w-100 py-2">Khám Phá Chi Tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>