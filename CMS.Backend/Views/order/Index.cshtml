@model IEnumerable<CMS.Data.Entities.Order>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Quản Lý Đơn Hàng";
}

<div class="container my-5" style="font-family: 'Georgia', serif; color: #433422;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 2px solid #433422;">
        <h2 class="fw-bold text-uppercase m-0" style="font-family: 'Courier New', serif; letter-spacing: 1px; text-shadow: 1px 1px 0px #ecdcb9;">
            <i class="fa-solid fa-boxes-packing me-2"></i> Đơn Hàng Đã Nhận
        </h2>
        <span class="badge py-2 px-3 fw-bold" style="background-color: #433422; color: #fff; font-family: 'Courier New';">
            TỔNG SỐ: @Model.Count() ĐƠN
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-2 mb-4 fw-bold" style="background-color: #e2f0d9; color: #385723; border-color: #385723; border-radius: 4px; box-shadow: 3px 3px 0px #385723;">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="card border-2 p-3 shadow-none" style="background-color: #ffffff; border-color: #433422; border-radius: 4px; box-shadow: 5px 5px 0px #433422;">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr style="font-family: 'Courier New', serif; border-bottom: 2px solid #433422;">
                        <th class="text-uppercase small fw-bold">Mã Đơn</th>
                        <th class="text-uppercase small fw-bold">Khách Hàng</th>
                        <th class="text-uppercase small fw-bold">Ngày Đặt</th>
                        <th class="text-uppercase small fw-bold">Trạng Thái</th>
                        <th class="text-uppercase small fw-bold">Tổng Tiền</th>
                        <th class="text-uppercase small fw-bold text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px dashed #eadeca;">
                            <td class="fw-bold" style="font-family: 'Courier New';">#@item.Id</td>
                            <td>
                                <span class="fw-bold d-block">@(item.Customer != null ? item.Customer.FullName : "Khách vô danh")</span>
                                <small class="text-muted italic small">@item.Notes</small>
                            </td>
                            <td style="font-family: 'Courier New';">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (item.Status == 0)
                                {
                                    <span class="badge border border-dark text-dark fw-bold px-3 py-2" style="background-color: #fce4d6; border-radius: 4px; box-shadow: 2px 2px 0px #433422;">Chờ xác nhận</span>
                                }
                                else if (item.Status == 1)
                                {
                                    <span class="badge border border-dark text-white fw-bold px-3 py-2" style="background-color: #2c5d63; border-radius: 4px; box-shadow: 2px 2px 0px #433422;">Đang giao hàng</span>
                                }
                                else if (item.Status == 2)
                                {
                                    <span class="badge border border-dark text-white fw-bold px-3 py-2" style="background-color: #548235; border-radius: 4px; box-shadow: 2px 2px 0px #433422;">Đã hoàn thành</span>
                                }
                                else if (item.Status == 3)
                                {
                                    <span class="badge border border-dark text-white fw-bold px-3 py-2" style="background-color: #a74343; border-radius: 4px; box-shadow: 2px 2px 0px #433422;">Đã hủy đơn</span>
                                }
                            </td>
                            <td class="fw-bold" style="font-family: 'Courier New'; color: #a74343;">
                                @(item.OrderDetails != null ? item.OrderDetails.Sum(d => d.Quantity * d.UnitPrice).ToString("N0") : "0")đ
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (item.Status == 0)
                                    {
                                        <a asp-action="Confirm" asp-route-id="@item.Id" class="btn btn-sm text-uppercase fw-bold border-2 text-white me-1" style="background-color: #548235; border-color: #433422; box-shadow: 2px 2px 0px #433422;">
                                            <i class="fa-solid fa-check"></i> Duyệt
                                        </a>
                                    }
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm text-uppercase fw-bold border-2 text-dark bg-white me-1" style="border-color: #433422; box-shadow: 2px 2px 0px #433422;">
                                        <i class="fa-solid fa-pen-to-square"></i> Cập Nhật
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm text-uppercase fw-bold border-2 text-white" style="background-color: #a74343; border-color: #433422; box-shadow: 2px 2px 0px #433422;" onclick="return confirm('Bạn có chắc muốn xóa vĩnh viễn hóa đơn này không?')">
                                        <i class="fa-solid fa-trash"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>