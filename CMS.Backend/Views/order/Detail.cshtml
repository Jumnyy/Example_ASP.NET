@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
}

<div class="container my-5" style="font-family: 'Georgia', serif; color: #433422; max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2" style="border-bottom: 2px solid #433422;">
        <h2 class="fw-bold text-uppercase m-0" style="font-family: 'Courier New', serif; letter-spacing: 1px;">
            <i class="fa-solid fa-receipt me-2"></i> Hóa Đơn Chi Tiết #@Model.Id
        </h2>
        <a asp-action="Index" class="btn btn-sm fw-bold border-2" style="border-color: #433422; background-color: #ffffff; box-shadow: 2px 2px 0px #433422;">
            QUAY LẠI DANH SÁCH
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card border-2 p-4 h-100" style="background-color: #f4ebd0; border-color: #433422; border-radius: 4px; box-shadow: 4px 4px 0px #433422;">
                <h5 class="fw-bold text-uppercase mb-3" style="font-family: 'Courier New'; border-bottom: 1px solid #433422; padding-bottom: 5px;">Khách Hàng</h5>
                <p class="mb-2"><strong>Họ tên:</strong> @(Model.Customer != null ? Model.Customer.FullName : "Khách vô danh")</p>
                <p class="mb-2"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="mb-0"><strong>Ghi chú:</strong> <span class="text-muted italic">@Model.Notes</span></p>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card border-2 p-4 h-100" style="border-color: #433422; border-radius: 4px; box-shadow: 4px 4px 0px #433422;">
                <h5 class="fw-bold text-uppercase mb-3" style="font-family: 'Courier New'; border-bottom: 1px solid #433422; padding-bottom: 5px;">Danh Sách Món</h5>

                <div class="table-responsive">
                    <table class="table align-middle table-sm mb-0">
                        <thead>
                            <tr style="font-family: 'Courier New';">
                                <th>Bánh</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Đơn Giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderDetails != null)
                            {
                                foreach (var detail in Model.OrderDetails)
                                {
                                    <tr style="border-bottom: 1px dashed #eadeca;">
                                        <td class="fw-bold">@(detail.Product != null ? detail.Product.Name : "Sản phẩm đã xóa")</td>
                                        <td class="text-center fw-bold" style="font-family: 'Courier New';">x@detail.Quantity</td>
                                        <td class="text-end" style="font-family: 'Courier New';">@detail.UnitPrice.ToString("N0")đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between mt-3 pt-2 align-items-center" style="border-top: 2px solid #433422;">
                    <span class="fw-bold text-uppercase small">Tổng Doanh Thu:</span>
                    <span class="fw-bold h4 m-0" style="font-family: 'Courier New'; color: #a74343;">
                        @(Model.OrderDetails != null ? Model.OrderDetails.Sum(d => d.Quantity * d.UnitPrice).ToString("N0") : "0")đ
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>