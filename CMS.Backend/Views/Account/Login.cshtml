@{
    Layout = null; // Trang đăng nhập độc lập, không dùng Layout chung
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập hệ thống - Vintage CMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background-color: #f5f2eb; /* Màu nền giấy thô cũ */
            background-image: radial-gradient(#e6dfd3 1px, transparent 1px); /* Hiệu ứng chấm giấy hạt li ti vintage */
            background-size: 20px 20px;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .vintage-card {
            border: 2px dashed #52433a; /* Viền đứt nét giả cổ */
            border-radius: 0px; /* Góc vuông cạnh sắc nét phong cách retro */
            background-color: #fdfbf7;
            box-shadow: 0 10px 30px rgba(61, 49, 42, 0.15) !important;
        }

        .vintage-header {
            background-color: #3d312a; /* Màu nâu gỗ trầm đồng bộ Sidebar */
            color: #f5ebd9 !important; /* Chữ vàng cát nhẹ */
            border-bottom: 2px solid #c49a6c; /* Đường chỉ vàng đồng */
            border-radius: 0px;
        }

            .vintage-header h4 {
                font-family: 'Playfair Display', serif;
                font-weight: 700;
                letter-spacing: 1px;
            }

        .form-label {
            font-weight: 700;
            color: #52433a;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-control {
            border-radius: 0px;
            border: 1px solid #c8bfae;
            background-color: #fffdfa;
            padding: 10px 12px;
            color: #3e322b;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background-color: #ffffff;
                border-color: #556b2f; /* Đổi viền xanh rêu khi click */
                box-shadow: 0 0 0 0.25rem rgba(85, 107, 47, 0.15);
                color: #3e322b;
            }

        /* Nút đăng nhập phong cách cổ điển */
        .btn-vintage {
            background-color: #556b2f; /* Màu xanh rêu cổ điển */
            color: #fffdec;
            border: 1px solid #485c28;
            border-radius: 0px;
            padding: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

            .btn-vintage:hover {
                background-color: #3d312a; /* Di chuột đổi sang màu nâu gỗ */
                border-color: #2b221d;
                color: #f5ebd9;
            }

        .vintage-footer-text {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            color: #8c7667;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-8 col-md-6 col-lg-4">

                <div class="card vintage-card border-0">
                    <div class="card-header vintage-header text-center py-4">
                        <i class="bi bi-journal-bookmark-fill text-warning fs-2 d-block mb-2"></i>
                        <h4 class="mb-0 text-uppercase">ThienCMS Admin</h4>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Login" method="post">

                            <div class="mb-3">
                                <label class="form-label"><i class="bi bi-person"></i> Tên đăng nhập</label>
                                <input type="text" name="username" class="form-control" placeholder="Nhập tài khoản quản trị..." required autocomplete="off" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label"><i class="bi bi-lock"></i> Mật khẩu</label>
                                <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                            </div>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger py-2 small border-0 rounded-0 mb-3" style="background-color: #fce8e6; color: #a82416;">
                                    <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
                                </div>
                            }

                            <button type="submit" class="btn btn-vintage w-100 shadow-sm">
                                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập hệ thống
                            </button>
                        </form>
                    </div>

                    <div class="card-footer bg-transparent border-0 text-center pb-3">
                        <span class="vintage-footer-text">— Established Since 2026 —</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>
</html>