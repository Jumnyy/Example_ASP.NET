@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Thêm mới Sản phẩm";
}

<style>
    .luxury-title {
        font-family: 'Playfair Display', 'Georgia', serif;
        letter-spacing: 1px;
        color: #111111;
    }

    .form-control {
        border-radius: 0px;
        border: 1px solid #cccccc;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.25);
        }

    .btn-gold {
        background-color: #111111;
        color: #ffffff;
        border: 1px solid #111111;
        border-radius: 0px;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

        .btn-gold:hover {
            background-color: #d4af37;
            border-color: #d4af37;
            color: #111111;
        }

    .btn-close-luxury {
        border-radius: 0px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<div class="container mt-5">
    <h3 class="text-uppercase luxury-title fw-bold mb-3">Thêm Mới Tuyệt Phẩm</h3>
    <div style="width: 50px; height: 2px; background-color: #d4af37;" class="mb-4"></div>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label fw-bold small text-uppercase">Tên Sản Phẩm <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Price" class="control-label fw-bold small text-uppercase">Giá Bán (VNĐ)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="stockQuantity" class="control-label fw-bold small text-uppercase">Tồn Kho</label>
                        <input asp-for="stockQuantity" type="number" class="form-control" placeholder="0" />
                        <span asp-validation-for="stockQuantity" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CategoryProductId" class="control-label fw-bold small text-uppercase">Danh Mục Sản Phẩm</label>
                    <select asp-for="CategoryProductId" class="form-control" asp-items="ViewBag.CategoryList">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryProductId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold small text-uppercase">Hình Ảnh Sản Phẩm <span class="text-danger">*</span></label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" required />
                    <span class="text-muted small">Hỗ trợ định dạng: .jpg, .jpeg, .png, .webp</span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Description" class="control-label fw-bold small text-uppercase">Mô Tả Sản Phẩm</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả chi tiết nét độc bản của sản phẩm..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group pt-2">
                    <button type="submit" class="btn btn-gold px-4 py-2">Lưu Sản Phẩm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-close-luxury ms-2 px-4 py-2">Quay Lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}