@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Thêm Mới Banner";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-success text-white">
            <h4 class="m-0 fw-bold">TẠO MỚI BANNER</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Tiêu Đề Banner</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề chương trình..." required />
                </div>

                <div class="mb-3">
                    <label for="imageUpload" class="form-label fw-bold">Chọn Hình Ảnh</label>
                    <input type="file" id="imageUpload" name="ImageFile" class="form-control" accept="image/*" required onchange="previewImage(event)" />
                    <small class="text-muted">Hỗ trợ các định dạng: .jpg, .jpeg, .png, .gif, .webp</small>

                    <div class="mt-2 text-center">
                        <img id="imagePreview" src="#" alt="Xem trước hình ảnh" class="img-thumbnail d-none" style="max-height: 150px;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="LinkUrl" class="form-label fw-bold">Đường Dẫn Khi Click (Link URL)</label>
                    <input asp-for="LinkUrl" class="form-control" placeholder="Ví dụ: /products hoặc /khuyen-mai" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayOrder" class="form-label fw-bold">Thứ Tự Hiển Thị</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label fw-bold">Trạng Thái</label>
                        <select asp-for="Status" class="form-select">
                            <option value="1">Hiển Thị (Active)</option>
                            <option value="0">Ẩn (Block)</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Lưu Lại</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay Lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            const input = event.target;
            const preview = document.getElementById('imagePreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.src = "#";
                preview.classList.add('d-none');
            }
        }
    </script>
}