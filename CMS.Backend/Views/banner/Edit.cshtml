@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Cập Nhật Banner";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="m-0 fw-bold">CẬP NHẬT BANNER MÃ #@Model.Id</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Tiêu Đề Banner</label>
                    <input asp-for="Title" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-bold">Đường Dẫn Hình Ảnh (URL Ảnh)</label>
                    <input asp-for="ImageUrl" class="form-control" required />
                    <div class="mt-2">
                        <small class="text-muted d-block mb-1">Ảnh hiện tại:</small>
                        <img src="@Model.ImageUrl" style="max-height: 100px; border: 1px solid #ddd; padding: 3px;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="LinkUrl" class="form-label fw-bold">Đường Dẫn Khi Click (Link URL)</label>
                    <input asp-for="LinkUrl" class="form-control" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayOrder" class="form-label fw-bold">Thứ Tự Hiển Thị</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label fw-bold">Trạng Thái</label>
                        <select asp-for="Status" class="form-select">
                            <option value="1">Hiển Thị (Active)</option>
                            <option value="0">Ẩn (Block)</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-warning px-4 fw-bold">Cập Nhật</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay Lại</a>
                </div>
            </form>
        </div>
    </div>
</div>