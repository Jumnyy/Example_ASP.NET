@model IEnumerable<CMS.Data.Entities.User>

@{
    ViewData["Title"] = "Table User";
}

<style>
    .user-table-container {
        width: 900px;
        margin: 30px auto;
    }

    .title {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

        table th,
        table td {
            border: 1px solid black;
            padding: 18px;
            text-align: left;
            font-size: 22px;
        }

        table th {
            font-weight: bold;
        }

        table tbody tr {
            height: 90px;
        }
</style>

<div class="user-table-container">

    <div class="title">
        Table User
    </div>

    <table>
        <thead>
            <tr>
                <th>Username</th>
                <th>FullName</th>
                <th>Role</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Username</td>
                    <td>@item.FullName</td>
                    <td>@item.Role</td>
                </tr>
            }
        </tbody>
    </table>

</div>